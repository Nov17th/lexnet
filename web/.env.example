SPARQL_ENDPOINT=http://localhost:3030/lexnet/query
# Quote hash IRIs so dotenv preserves the fragment delimiter.
LEXNET_RESOURCE_BASE="https://nov17th.github.io/lexnet/build/lexnet-full.ttl#"
LEXNET_SCHEMA_IRI="https://nov17th.github.io/lexnet/ontology/lexnet-ontology.ttl#"
LEXNET_RDF_FILE=../build/lexnet-full.ttl
LEXNET_QUERIES_FILE=../queries/queries.rq
SPARQL_TIMEOUT_MS=10000
SPARQL_RESULT_LIMIT=300
GRAPH_NODE_LIMIT=80
GRAPH_EDGE_LIMIT=150
WIKIDATA_ENABLED=true
WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
WIKIDATA_TIMEOUT_MS=8000
WIKIDATA_CACHE_TTL_MS=3600000
# Directory containing fuseki-server.jar; optional with bundled .tools installation
FUSEKI_HOME=
JAVA_HOME=
